---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../site.config';
---

<BaseLayout title="页面不存在" description="没有找到这个页面。">
  <section class="hero">
    <h1>404</h1>
    <p>这个页面不存在，或者已经被我删掉了。</p>
    <p><a href={withBase('')}>回到首页 →</a></p>
  </section>
</BaseLayout>
