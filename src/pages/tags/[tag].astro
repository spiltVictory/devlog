---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Set(posts.flatMap((post) => post.data.tags));
  return [...tags].map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const posts = (await getPosts()).filter((post) => post.data.tags.includes(tag));
---

<BaseLayout title={`标签：${tag}`} description={`所有关于「${tag}」的开发日志。`}>
  <section class="hero">
    <h1>标签：{tag}</h1>
    <p>共 {posts.length} 篇。</p>
  </section>

  <ul class="post-list">
    {
      posts.map((entry) => (
        <li>
          <PostCard entry={entry} showTags={false} />
        </li>
      ))
    }
  </ul>
</BaseLayout>
