---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectTags, getPosts } from '../../posts';
import { withBase } from '../../site.config';

const posts = await getPosts();
const tags = collectTags(posts);
---

<BaseLayout title="标签" description="按标签浏览所有开发日志。">
  <section class="hero">
    <h1>标签</h1>
    <p>共 {tags.length} 个标签。</p>
  </section>

  <div class="tag-cloud">
    {
      tags.map(({ tag, count }) => (
        <a class="tag" href={withBase(`tags/${tag}/`)}>
          {tag} · {count}
        </a>
      ))
    }
  </div>
</BaseLayout>
